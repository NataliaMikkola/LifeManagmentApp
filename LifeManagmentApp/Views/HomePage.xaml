<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:LifeManagementApp.ViewModels"
    xmlns:models="clr-namespace:LifeManagementApp.Models"
    x:Class="LifeManagementApp.Views.HomePage"
    x:DataType="viewmodels:HomeViewModel"
    Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Life Management"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Top 3 Tasks"
                FontSize="21"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding TopTasks}"
                HeightRequest="210"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label Text="No unfinished tasks." />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TodoItem">

                        <Border
                            Stroke="Gray"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="0,4">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="17"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Priority,
                                        StringFormat='Priority: {0}'}" />

                                <Label
                                    Text="{Binding DueDate,
                                        StringFormat='Due: {0:dd MMM yyyy}'}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                Text="Current Weather — Vaasa"
                FontSize="21"
                FontAttributes="Bold" />

            <Label
                Text="{Binding TemperatureText}"
                FontSize="30" />

            <Label
                Text="{Binding WindSpeedText,
                    StringFormat='Wind: {0}'}"
                FontSize="18" />

            <Label
                Text="🪁 Kitesurf weather!"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="Green"
                IsVisible="{Binding IsKitesurfWeather}" />

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <Button
                Text="Refresh"
                Command="{Binding LoadCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
